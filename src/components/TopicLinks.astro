---
import { topicHref } from '../lib/url';
import type { Topic } from '../lib/topics';

/**
 * Renders a list of topic links, used for both `prerequisites` and `seeAlso`.
 *
 * Ids are turned into topics by `resolveTopicIds` in src/lib/topics.ts, which is where
 * the "no such topic" build failure lives. This component only draws the result — and
 * draws nothing at all when the list is empty, so a caller whose every link was dropped
 * does not end up with a heading standing over an empty `<ul>`.
 */
interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

{
  topics.length > 0 && (
    <ul class="topic-links">
      {topics.map((topic) => (
        <li>
          <a href={topicHref(topic.id)}>{topic.data.title}</a>
          <span class="topic-links__blurb">{topic.data.description}</span>
        </li>
      ))}
    </ul>
  )
}
