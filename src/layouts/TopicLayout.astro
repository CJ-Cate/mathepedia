---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TopicLinks from '../components/TopicLinks.astro';
import TopicVideo from '../components/TopicVideo.astro';
import { CATEGORIES, formatDate, getUpdated, resolveTopicIds, type Topic } from '../lib/topics';
import { categoryHref } from '../lib/url';

interface Props {
  topic: Topic;
  headings: MarkdownHeading[];
  /** Rendered heading markup keyed by slug. See `src/lib/rehype-heading-html.mjs`. */
  headingHtml?: Record<string, string>;
}

const { topic, headings, headingHtml } = Astro.props;
const { title, description, category, tags, prerequisites, seeAlso, draft, youtube } =
  topic.data;
const updated = getUpdated(topic);

const categoryMeta = CATEGORIES[category];

/*
 * Resolved here rather than inside `TopicLinks` so the box and its heading are decided by
 * the same count. An id list can be non-empty and still produce no links -- every target
 * withheld -- and a "Read first" box with nothing in it is worse than no box.
 */
const prereqTopics = await resolveTopicIds(prerequisites, 'prerequisites', topic.id);
const seeAlsoTopics = await resolveTopicIds(seeAlso, 'seeAlso', topic.id);
---

<BaseLayout title={title} description={description} path={`/topics/${topic.id}/`}>
  <article class="article">
    <header class="article__header">
      <h1>{title}</h1>
      <p class="article__meta">
        <a class="chip" href={categoryHref(category)}>{categoryMeta.singular}</a>
        {draft && <span class="chip">Draft</span>}
        {updated && <span>Last updated {formatDate(updated)}</span>}
      </p>
    </header>

    {
      prereqTopics.length > 0 && (
        <section class="prereqs" aria-label="Suggested reading first">
          <p class="prereqs__title">Read first</p>
          <TopicLinks topics={prereqTopics} />
        </section>
      )
    }

    <div class="article__top">
      <TableOfContents headings={headings} headingHtml={headingHtml} />
      {youtube && <TopicVideo url={youtube} title={`Video: ${title}`} />}
    </div>

    {/*
      `data-pagefind-body` scopes the search index to the article itself. Without it
      Pagefind indexes the masthead and sidebar on every page, and searching for
      "Categories" returns all 40 articles.
    */}
    <div
      id="introduction"
      class="article__body"
      data-pagefind-body
      data-pagefind-meta={`category:${categoryMeta.singular}`}
    >
      <slot />
    </div>

    <footer class="article__footer">
      {
        seeAlsoTopics.length > 0 && (
          <>
            <h2>See also</h2>
            <TopicLinks topics={seeAlsoTopics} />
          </>
        )
      }

      {
        tags.length > 0 && (
          <p class="article__meta" style="margin-top:1rem">
            {tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </p>
        )
      }
    </footer>
  </article>
</BaseLayout>
